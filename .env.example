# docker compose settings. Copy to .env and fill every empty value.

# `cd backend && php artisan key:generate --show`
APP_KEY=
APP_URL=http://localhost:3000

DB_DATABASE=radarisu
DB_USERNAME=radarisu
DB_PASSWORD=

# Demo accounts (UserSeeder). MUST be changed on any production deploy.
DEMO_USER_PASSWORD=

FRONTEND_PORT=3000

# Laravel trusts X-Forwarded-For only from this address (the BFF container).
DOCKER_SUBNET=172.28.0.0/24
BFF_IP=172.28.0.10
